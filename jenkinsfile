pipeline {
    agent any

    stages {
        stage('Welcome') {
            steps {
                echo 'Hello, World!'
            }
        }

        stage('Build') {
            steps {
                echo 'Building application...'
            }
        }

        stage('Quality') {
            steps {
                echo 'Running code quality checks...'
            }
        }

        stage('Test') {
            steps {
                echo 'Running automated tests...'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
